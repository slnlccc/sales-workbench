PORT=3001
MONGODB_URI=mongodb://localhost:27017/sales-workbench
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 百度千帆 AI 配置（当前使用）
# 获取方式：https://console.bce.baidu.com/qianfan/ais/console/applicationConsole/application
# 注册后在「应用列表」创建应用，获取 API Key 和 Secret Key
# 免费模型：ernie-speed-128k（ERNIE Speed，免费）
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
BAIDU_MODEL=ernie-speed-128k

# 腾讯云COS配置
# 获取方式：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_COS_BUCKET=your-cos-bucket
TENCENT_COS_REGION=ap-guangzhou
# 同步间隔（毫秒），默认5分钟
SYNC_INTERVAL=300000
