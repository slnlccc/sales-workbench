<view class="page">
  <view class="header">
    <text class="title">✈️ 出差报告</text>
    <text class="subtitle">粘贴原始出差记录 → AI 自动归纳八大卡片 → 生成Word</text>
  </view>

  <view class="card basic-card">
    <view class="card-title"><view class="dot"></view><text>一、基本信息（可选，AI会从总框识别）</text></view>

    <view class="row">
      <view class="form-item col-half">
        <text class="label">出差人</text>
        <input class="input" placeholder="如：单璟僖/马奕泓/赵涛" data-field="travelers" value="{{form.travelers}}" bindinput="onInput" />
      </view>
      <view class="form-item col-half">
        <text class="label">出差日期</text>
        <picker mode="date" value="{{form.travelDate}}" bindchange="onDateChange">
          <view class="input picker-input">{{form.travelDate}}</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="label">出差地点</text>
      <input class="input" placeholder="如：上海临港" data-field="location" value="{{form.location}}" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="label">主要目的（可多选）</text>
      <view class="tag-row">
        <view wx:for="{{purposeOptions}}" wx:key="*this"
              class="tag {{form.purpose.indexOf(item) >= 0 ? 'tag-active' : ''}}"
              data-opt="{{item}}" bindtap="togglePurpose">{{item}}</view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">客户单位 / 姓名 / 职位</text>
      <input class="input" placeholder="如：上海一机床厂 于耀华(总)、楼杭飞(书记)" data-field="clients" value="{{form.clients}}" bindinput="onInput" />
    </view>
  </view>

  <view class="card raw-card">
    <view class="card-title">
      <view class="dot"></view>
      <text>二、原始出差记录（总框，粘贴任意文本）</text>
      <text class="char-count {{rawCharCount > 100 ? 'text-green' : ''}}">{{rawCharCount}}字</text>
    </view>
    <view class="tip-row">
      <text class="tip">💡 可直接粘贴笔记/语音转文字/聊天记录/群汇报，AI 自动提取为标准切换/时间节点/采购模式/远期增量/标杆/准入/品类/竞品梯队/切入路径等完整结构</text>
    </view>
    <textarea
      class="raw-textarea"
      placeholder="示例：8月13日单璟僖一行到上海，拜访了一机床于耀华总经理和楼杭飞书记，讨论了华龙2.0融合...（可粘贴任意格式的原始记录）"
      value="{{form.rawText}}"
      data-field="rawText"
      bindinput="onInput"
      auto-height
      maxlength="-1"
    />
    <view class="action-row">
      <view class="link-btn" bindtap="loadSample">📄 加载示例</view>
      <view class="link-btn danger" wx:if="{{form.rawText}}" bindtap="clearRaw">🗑️ 清空</view>
      <button class="btn-primary generate-btn" bindtap="handleSubmit" disabled="{{loading}}">
        <text wx:if="{{!loading}}">✨ 一键生成八大卡片报告</text>
        <text wx:else>生成中…</text>
      </button>
    </view>
  </view>

  <view style="height:40rpx;"></view>

  <!-- 结果弹窗 -->
  <view wx:if="{{showResult}}" class="modal-mask" bindtap="closeResult" catchtouchmove="stopPropagation">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">📄 报告预览（八大卡片结构化）</text>
        <view class="close-btn" bindtap="closeResult">×</view>
      </view>
      <view class="error-tip" wx:if="{{errorMsg}}">⚠️ {{errorMsg}}</view>
      <scroll-view scroll-y class="modal-body">
        <text class="report-content">{{generatedContent}}</text>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-secondary btn-sm" bindtap="closeResult">关闭</button>
        <button class="btn-secondary btn-sm" bindtap="downloadReport">下载MD</button>
        <button class="btn-word btn-sm" bindtap="downloadWord">下载Word</button>
        <button class="btn-primary btn-sm" bindtap="copyReport">复制</button>
      </view>
    </view>
  </view>
</view>
