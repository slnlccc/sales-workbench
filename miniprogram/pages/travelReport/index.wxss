.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #F9F5F0;
}

/* 顶部标题卡片 */
.header-card {
  background: linear-gradient(135deg, #6F4E37 0%, #8B6F47 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(111, 78, 55, 0.2);
}
.header-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}
.header-sub {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  margin-top: 8rpx;
  display: block;
}

/* 警告条 */
.warning-bar {
  background: #FEF3C7;
  border: 1rpx solid #FCD34D;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.warning-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.warning-text {
  color: #92400E;
  font-size: 24rpx;
  line-height: 1.5;
  flex: 1;
}

/* 子分组（关键影响4小点、板材竞品/切入路径等） */
.sub-group {
  background: #FDFBF8;
  border: 2rpx solid #E5DDD3;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 12rpx;
}
.sub-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6F4E37;
  margin-bottom: 16rpx;
  display: block;
}


.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2817;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  background: #6F4E37;
  border-radius: 50%;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 24rpx;
  color: #9C8574;
  margin-bottom: 10rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E5DDD3;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #3D2817;
  background: #FDFBF8;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E5DDD3;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #3D2817;
  background: #FDFBF8;
  box-sizing: border-box;
}
.picker-value {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E5DDD3;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #3D2817;
  background: #FDFBF8;
  box-sizing: border-box;
}

/* 生成按钮 */
.btn-generate {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #6F4E37 0%, #8B6F47 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(111, 78, 55, 0.3);
  margin-top: 12rpx;
}
.btn-generate[disabled] {
  opacity: 0.6;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content {
  width: 92%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #F0EBE3;
}
.modal-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D2817;
}
.badge-fallback {
  background: #FEF3C7;
  color: #92400E;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.modal-close {
  font-size: 36rpx;
  color: #C4B5A0;
  padding: 8rpx;
}
.modal-body {
  flex: 1;
  padding: 32rpx;
  max-height: 60vh;
}
.report-content {
  font-size: 26rpx;
  color: #3D2817;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #F0EBE3;
}
.btn-sm {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  margin: 0;
}
.btn-primary {
  background: #6F4E37;
  color: #fff;
}
.btn-secondary {
  background: #F5F3F0;
  color: #6F4E37;
}
.btn-word {
  background: linear-gradient(135deg, #1D4ED8, #3B82F6);
  color: #fff;
}
