.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.project-item {
  padding: 12rpx;
  background: #F9F5F0;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.project-item:last-child {
  margin-bottom: 0;
}

.progress-bar {
  height: 8rpx;
  background: #EDE6DE;
  border-radius: 4rpx;
  margin-top: 8rpx;
}

.progress-fill {
  height: 100%;
  background: #6F4E37;
  border-radius: 4rpx;
}

.action-link {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 24rpx;
  color: #9C8574;
  margin-bottom: 8rpx;
  display: block;
}
