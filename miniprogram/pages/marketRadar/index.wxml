<view class="container">
  <view class="card mb-3" style="background:#6F4E37;color:#fff;">
    <view>
      <text class="text-lg font-bold">市情雷达</text>
      <text class="text-xs opacity-70" style="display:block;">行业动态 · 原材料价格 · 智能推荐</text>
    </view>
  </view>

  <view class="card mb-3">
    <view class="flex justify-between items-center mb-2">
      <text class="text-sm font-medium text-coffee-800">行业动态</text>
      <text class="text-xs text-coffee-400">每日更新</text>
    </view>
    <view class="flex gap-2 mb-3">
      <text 
        wx:for="{{categories}}" 
        wx:key="index"
        class="category-tag"
        bindtap="filterNews"
        data-idx="{{index}}"
        style="{{selectedCategory === item ? 'background:#6F4E37;color:#fff;' : ''}}"
      >{{item}}</text>
    </view>
    <view wx:for="{{getFilteredNews()}}" wx:key="id" class="news-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="flex justify-between items-start">
        <view class="flex-1">
          <text class="text-sm font-medium">{{item.title}}</text>
          <text class="text-xs text-coffee-400" style="display:block;margin-top:4rpx;">{{item.source}} · {{item.date}}</text>
        </view>
        <text wx:if="{{item.tag}}" class="tag tag-red" style="margin-left:12rpx;">{{item.tag}}</text>
      </view>
      <text class="text-xs text-coffee-500" style="display:block;margin-top:8rpx;">{{item.summary}}</text>
    </view>
  </view>

  <view class="card mb-3">
    <view class="flex justify-between items-center mb-2">
      <text class="text-sm font-medium text-coffee-800">原材料价格</text>
      <text class="text-xs text-coffee-400">每周一更新 · 数据来源：中国金属网</text>
    </view>
    <view class="material-list">
      <view wx:for="{{materials}}" wx:key="name" class="material-item">
        <text class="text-sm font-medium">{{item.name}}</text>
        <view class="flex items-center">
          <text class="text-sm">{{item.price}} {{item.unit}}</text>
          <text class="text-xs" style="{{item.trend === 'up' ? 'color:#EF4444;' : 'color:#16A34A;'}}">
            {{item.trend === 'up' ? '↑' : '↓'}}{{item.change}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <view class="card mb-3">
    <view class="flex justify-between items-center mb-2">
      <text class="text-sm font-medium text-coffee-800">行业见解</text>
      <text class="text-xs text-coffee-400">AI智能分析</text>
    </view>
    <view wx:for="{{insights}}" wx:key="index" class="insight-item">
      <text class="text-xs text-coffee-600">• {{item}}</text>
    </view>
  </view>

  <view class="card mb-3">
    <view class="flex justify-between items-center mb-2">
      <text class="text-sm font-medium text-coffee-800">竞争对手动态</text>
      <view class="flex items-center" bindtap="refreshCompetitors">
        <text class="text-xs text-coffee-400" style="margin-right:8rpx;">{{competitorsLoading ? '刷新中...' : '刷新'}}</text>
        <text class="text-xs text-coffee-400">{{competitorsLastUpdate}}</text>
      </view>
    </view>

    <!-- 分类筛选器 -->
    <view wx:if="{{competitors.length > 0}}" style="margin-bottom:16rpx;">
      <!-- 竞争对手名称筛选 -->
      <view class="flex items-center" style="margin-bottom:8rpx;flex-wrap:wrap;">
        <text class="text-xs text-coffee-400" style="width:120rpx;flex-shrink:0;">竞争对手：</text>
        <view class="flex" style="flex-wrap:wrap;flex:1;">
          <text
            wx:for="{{competitorNames}}"
            wx:key="*this"
            class="comp-filter-tag"
            bindtap="filterCompetitorName"
            data-name="{{item}}"
            style="{{competitorFilterName === item ? 'background:#EF4444;color:#fff;' : ''}}"
          >{{item}}</text>
        </view>
      </view>
      <!-- 信息渠道筛选 -->
      <view class="flex items-center" style="margin-bottom:8rpx;flex-wrap:wrap;">
        <text class="text-xs text-coffee-400" style="width:120rpx;flex-shrink:0;">信息渠道：</text>
        <view class="flex" style="flex-wrap:wrap;flex:1;">
          <text
            wx:for="{{competitorChannels}}"
            wx:key="*this"
            class="comp-filter-tag"
            bindtap="filterCompetitorChannel"
            data-channel="{{item}}"
            style="{{competitorFilterChannel === item ? 'background:#A78BFA;color:#fff;' : ''}}"
          >{{item}}</text>
        </view>
      </view>
      <!-- 动态类型筛选 -->
      <view class="flex items-center" style="margin-bottom:8rpx;flex-wrap:wrap;">
        <text class="text-xs text-coffee-400" style="width:120rpx;flex-shrink:0;">动态类型：</text>
        <view class="flex" style="flex-wrap:wrap;flex:1;">
          <text
            wx:for="{{competitorTypes}}"
            wx:key="*this"
            class="comp-filter-tag"
            bindtap="filterCompetitorType"
            data-type="{{item}}"
            style="{{competitorFilterType === item ? 'background:#F59E0B;color:#fff;' : ''}}"
          >{{item}}</text>
        </view>
      </view>
      <!-- 筛选状态与清除 -->
      <view class="flex justify-between items-center" style="margin-top:4rpx;">
        <text class="text-xs text-coffee-400">共 {{filteredCompetitors.length}} 条动态</text>
        <text
          wx:if="{{competitorFilterName !== '全部对手' || competitorFilterChannel !== '全部来源' || competitorFilterType !== '全部类别'}}"
          class="text-xs text-blue-500"
          bindtap="clearCompetitorFilter"
        >清除筛选</text>
      </view>
    </view>

    <view wx:if="{{competitors.length === 0}}" class="news-item">
      <text class="text-xs text-coffee-400">{{competitorsLoading ? '正在拉取最新动态...' : '暂无竞争对手动态，点击右上角刷新'}}</text>
    </view>
    <view wx:if="{{filteredCompetitors.length === 0 && competitors.length > 0}}" class="news-item">
      <text class="text-xs text-coffee-400">暂无符合筛选条件的动态</text>
    </view>
    <view wx:for="{{filteredCompetitors}}" wx:key="id" class="news-item" bindtap="goCompetitorDetail" data-id="{{item.id}}">
      <view class="flex justify-between items-start">
        <view class="flex-1">
          <view class="flex items-center" style="margin-bottom:4rpx;flex-wrap:wrap;">
            <view class="tag tag-red" style="margin-right:8rpx;">
              <text>{{item.competitorName}}</text>
              <text wx:if="{{item.stockCode}}" style="font-weight:normal;margin-left:4rpx;color:#F87171;">{{item.stockCode}}</text>
            </view>
            <text wx:if="{{item.channel === '招投标'}}" class="tag" style="background:#A78BFA;color:#fff;margin-right:8rpx;">{{item.channel}}</text>
            <text wx:elif="{{item.channel === '官网'}}" class="tag" style="background:#0EA5E9;color:#fff;margin-right:8rpx;">{{item.channel}}</text>
            <text wx:elif="{{item.channel === '公众号'}}" class="tag" style="background:#10B981;color:#fff;margin-right:8rpx;">{{item.channel}}</text>
            <text wx:elif="{{item.channel === '财报'}}" class="tag" style="background:#F59E0B;color:#fff;margin-right:8rpx;">{{item.channel}}</text>
            <text wx:elif="{{item.channel === '行业研报'}}" class="tag" style="background:#6366F1;color:#fff;margin-right:8rpx;">{{item.channel}}</text>
            <text wx:else class="tag" style="background:#A78BFA;color:#fff;margin-right:8rpx;">{{item.channel}}</text>
            <text class="tag" style="background:#06B6D4;color:#fff;margin-right:8rpx;">{{item.category}}</text>
            <text wx:if="{{item.isHighImpact}}" class="tag" style="background:linear-gradient(90deg,#EF4444,#F43F5E);color:#fff;margin-right:8rpx;">🔥高影响</text>
            <text wx:if="{{item.isNew}}" class="tag" style="background:linear-gradient(90deg,#FBBF24,#F97316);color:#fff;">⚡新</text>
            <text class="text-xs text-coffee-400" style="margin-left:auto;">{{item.publishedAt}}</text>
          </view>
          <text class="text-base font-bold" style="display:block;margin-top:4rpx;">{{item.title}}</text>
        </view>
      </view>
      <text class="text-xs text-coffee-500" style="display:block;margin-top:8rpx;line-height:1.6;">{{item.summary}}</text>
      <!-- 关键词标签 -->
      <view wx:if="{{item.keywords && item.keywords.length > 0}}" class="flex items-center" style="margin-top:12rpx;flex-wrap:wrap;">
        <text
          wx:for="{{item.keywords}}"
          wx:for-item="kw"
          wx:key="index"
          class="comp-keyword-tag"
        >{{kw}}</text>
      </view>
      <view class="flex justify-between items-center" style="margin-top:12rpx;">
        <text class="text-xs text-coffee-400">{{item.sourceName}}</text>
        <text class="text-xs font-bold" style="color:#DC2626;">竞争分析 ›</text>
      </view>
    </view>
  </view>
</view>