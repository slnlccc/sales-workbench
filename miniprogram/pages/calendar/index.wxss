.calendar-header {
  display: flex;
  margin-bottom: 8rpx;
}

.calendar-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9C8574;
  padding: 12rpx 0;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  position: relative;
}

.schedule-dot {
  width: 8rpx;
  height: 8rpx;
  background: #6F4E37;
  border-radius: 50%;
  margin-top: 4rpx;
}

.schedule-item {
  padding: 16rpx;
  background: #F9F5F0;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.schedule-item:last-child {
  margin-bottom: 0;
}

.line-through {
  text-decoration: line-through;
}

.action-link {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 24rpx;
  color: #9C8574;
  margin-bottom: 8rpx;
  display: block;
}
