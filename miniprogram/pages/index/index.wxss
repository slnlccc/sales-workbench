.header {
  padding: 20rpx 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.module-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(111, 78, 55, 0.06);
  transition: transform 0.2s;
}

.module-card:active {
  transform: scale(0.98);
}

.module-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D1F14;
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 24rpx;
  color: #9C8574;
}

.footer {
  padding: 40rpx 0;
}
