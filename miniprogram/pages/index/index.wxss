.header {
  padding: 20rpx 0;
}
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.user-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 40rpx;
  background: #FBF7F2;
}
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #6F4E37;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.username {
  font-size: 26rpx;
  color: #6F4E37;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-card {
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}
.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D1F14;
  display: block;
}
.panel-hint {
  font-size: 24rpx;
  color: #9C8574;
  display: block;
  margin: 8rpx 0 32rpx;
}
.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: #6F4E37;
  display: block;
  margin-bottom: 10rpx;
}
.form-input {
  background: #FBF7F2;
  border: 2rpx solid #EFE3D3;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2D1F14;
}
.btn {
  border-radius: 14rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
  border: none;
}
.btn-primary {
  background: #6F4E37;
  color: #fff;
}
.auth-switch {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9C8574;
}
.auth-switch .link {
  color: #6F4E37;
  font-weight: 600;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.module-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(111, 78, 55, 0.06);
  transition: transform 0.2s;
}

.module-card:active {
  transform: scale(0.98);
}

.module-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D1F14;
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 24rpx;
  color: #9C8574;
}

.footer {
  padding: 40rpx 0;
}
