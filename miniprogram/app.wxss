page {
  background-color: #F9F5F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #4A3728;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(111, 78, 55, 0.06);
}

.btn-primary {
  background: #6F4E37;
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.4;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #fff;
  color: #6F4E37;
  border: 2rpx solid #D4C4B5;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.btn-secondary:active {
  background: #F5F3F0;
}

.btn-danger {
  background: #EF4444;
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.4;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.input {
  background: #fff;
  border: 2rpx solid #D4C4B5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #4A3728;
  box-sizing: border-box;
  width: 100%;
}

.picker {
  background: #fff;
  border: 2rpx solid #D4C4B5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #4A3728;
}

.text-coffee-900 { color: #2D1F14; }
.text-coffee-700 { color: #6F4E37; }
.text-coffee-500 { color: #9C8574; }
.text-coffee-400 { color: #B8A99A; }

.bg-coffee-50 { background: #F9F5F0; }
.bg-coffee-100 { background: #EDE6DE; }
.bg-coffee-600 { background: #6F4E37; }

.text-red { color: #DC2626; }
.text-green { color: #16A34A; }
.text-amber { color: #D97706; }
.text-blue { color: #2563EB; }

.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }

.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }

.mr-1 { margin-right: 8rpx; }
.mr-2 { margin-right: 16rpx; }

.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }

.rounded-lg { border-radius: 16rpx; }
.rounded-xl { border-radius: 24rpx; }

.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }

.text-center { text-align: center; }

.whitespace-nowrap { white-space: nowrap; }

.divider {
  height: 2rpx;
  background: #EDE6DE;
  margin: 24rpx 0;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 90%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #EDE6DE;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-body {
  padding: 28rpx 32rpx;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #EDE6DE;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

/* Table */
.table-scroll {
  overflow-x: auto;
  white-space: nowrap;
}

.table-row {
  display: flex;
  border-bottom: 2rpx solid #F0EBE5;
}

.table-header-row {
  background: #F5F3F0;
  font-weight: 500;
  font-size: 24rpx;
  color: #6F4E37;
}

.table-cell {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #4A3728;
  flex-shrink: 0;
  min-width: 140rpx;
}

/* Tags */
.tag {
  display: inline-flex;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-green {
  background: #F0FDF4;
  color: #166534;
  border: 2rpx solid #BBF7D0;
}

.tag-amber {
  background: #FFFBEB;
  color: #92400E;
  border: 2rpx solid #FDE68A;
}

.tag-blue {
  background: #EFF6FF;
  color: #1E40AF;
  border: 2rpx solid #BFDBFE;
}

.tag-red {
  background: #FEF2F2;
  color: #991B1B;
  border: 2rpx solid #FECACA;
}

.tag-gray {
  background: #F5F5F4;
  color: #78716C;
  border: 2rpx solid #E7E5E4;
}

/* Scroll list */
.scroll-list {
  max-height: calc(100vh - 400rpx);
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #B8A99A;
  font-size: 28rpx;
}
