{
  "name": "sales-workbench-server",
  "version": "1.0.0",
  "description": "销售工作台后端API",
  "type": "commonjs",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "pkg . --target node18-win-x64 --output dist/sales-workbench.exe"
  },
  "pkg": {
    "assets": [
      "./node_modules/**/*",
      "../dist/**/*"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
